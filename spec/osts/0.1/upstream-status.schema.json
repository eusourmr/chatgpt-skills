{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eusourmr/chatgpt-skills/spec/osts/0.1/upstream-status.schema.json",
  "title": "OSTS 0.1 - Upstream Drift Status",
  "type": "object",
  "required": [
    "schema_version",
    "skill_id",
    "reviewed_source_revision",
    "reviewed_artifact_sha256",
    "current_artifact_sha256",
    "review_due_at",
    "state",
    "action",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill_id": {
      "type": "string"
    },
    "reviewed_source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reviewed_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "current_artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_due_at": {
      "type": "string",
      "format": "date"
    },
    "state": {
      "enum": [
        "current",
        "changed-unreviewed",
        "stale"
      ]
    },
    "action": {
      "enum": [
        "none",
        "re-review-required"
      ]
    },
    "policy": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
