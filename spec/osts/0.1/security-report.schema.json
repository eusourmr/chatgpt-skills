{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eusourmr/chatgpt-skills/spec/osts/0.1/security-report.schema.json",
  "title": "OSTS 0.1 - Structured Security Report",
  "type": "object",
  "required": ["schema_version","gate_version","skill_id","scanned_at","source_revision","artifact_sha256","result","summary","observed_capabilities","findings","policy"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_version": {"const": "v2"},
    "skill_id": {"type": "string"},
    "scanned_at": {"type": "string", "format": "date"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "artifact_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "result": {"enum": ["pass","blocked"]},
    "summary": {"type": "object"},
    "observed_capabilities": {"type": "object"},
    "findings": {"type": "array"},
    "policy": {"type": "string"}
  },
  "additionalProperties": false
}
